# Commit dates must not disclose acquisition dates: faire fake-dates every commit and tag.
[datalad]
	fake-dates = true
# Shared conversion containers. TODO: fill url and revision (also the image paths below).
[faire "collection.tools"]
	url = https://git.cpipstudy.org/ni-dataops/bids-containers
	path = code/containers
	revision = dev
# ReproNim containers at a pinned release. To use another version of a tool, change `image`
# to another image of this collection (and its version in dataset_description.json).
[faire "collection.repronim"]
	url = https://github.com/ReproNim/containers
	path = code/repronim_containers
	revision = 1.20260903.0
# DICOM to BIDS, one session of the stream. heudiconv writes no top-level file (notop):
# dataset_description.json and README ship with the template, participants.tsv and
# sessions.tsv are maintained by faire.
[datalad "containers.heudiconv"]
	image = code/containers/images/heudiconv.sif
	cmdexec = {img_dspath}/scripts/singularity_cmd exec --no-home --cleanenv --bind /tmp:/root/.cache/datalad {img} {cmd}
	faire-sourcedata = {{ dicom_stream }}
	faire-input = sourcedata/{{ dicom_stream }}/*/sub-{subject}/ses-{session}/*
	faire-output = sub-{subject}/ses-{session}
	faire-output = .heudiconv/{subject}/ses-{session}
	faire-cmd = heudiconv --files {inputs} -o . -f {{ heuristic }} -s {subject} -ss {session} -c dcm2niix -b notop --overwrite
{%- if physio_stream %}
# Physiological recordings to BIDS, next to the BOLD runs heudiconv wrote.
[datalad "containers.phys2bids"]
	image = code/containers/images/phys2bids.sif
	cmdexec = apptainer exec -e {img} {cmd}
	faire-sourcedata = {{ physio_stream }}
	faire-input = sourcedata/{{ physio_stream }}/*/sub-{subject}/ses-{session}/*
	faire-output = sub-{subject}/ses-{session}/func/*_physio.*
	faire-after = heudiconv
	faire-cmd = phys2bids -in {inputs} -outdir . -heur {{ phys2bids_heuristic }} -sub {subject} -ses {session}
{%- endif %}
{%- if eyetrack_stream %}
# Eye-tracking recordings (EyeLink EDF) to BIDS.
[datalad "containers.eye2bids"]
	image = code/containers/images/eye2bids.sif
	cmdexec = apptainer exec -e {img} {cmd}
	faire-sourcedata = {{ eyetrack_stream }}
	faire-input = sourcedata/{{ eyetrack_stream }}/*/sub-{subject}/ses-{session}/*.edf
	faire-output = sub-{subject}/ses-{session}/func/*_recording-eye*_physio.*
	faire-after = heudiconv
	faire-cmd = eye2bids --input_file {inputs} --metadata_file {{ eye2bids_metadata }} --output_dir sub-{subject}/ses-{session}/func
{%- endif %}
{%- if mrs_stream %}
# Raw MRS to NIfTI-MRS with a BIDS sidecar; the output names follow the input names.
[datalad "containers.spec2nii"]
	image = code/containers/images/spec2nii.sif
	cmdexec = apptainer exec -e {img} {cmd}
	faire-sourcedata = {{ mrs_stream }}
	faire-input = sourcedata/{{ mrs_stream }}/*/sub-{subject}/ses-{session}/*
	faire-output = sub-{subject}/ses-{session}/mrs/*
	faire-cmd = spec2nii {{ mrs_format }} -j -o sub-{subject}/ses-{session}/mrs {inputs}
{%- endif %}
{%- if ephys_stream %}
# MEG, EEG and iEEG recordings of one stream to BIDS. The script writes only the session's
# files (no participants.tsv, dataset_description.json or README: faire and the template own them).
[datalad "containers.mieeg2bids"]
	image = code/containers/images/mieeg2bids.sif
	cmdexec = apptainer exec -e {img} {cmd}
	faire-sourcedata = {{ ephys_stream }}
	faire-input = sourcedata/{{ ephys_stream }}/*/sub-{subject}/ses-{session}/*
	faire-output = sub-{subject}/ses-{session}/meg
	faire-output = sub-{subject}/ses-{session}/eeg
	faire-output = sub-{subject}/ses-{session}/ieeg
	faire-after = heudiconv
	faire-cmd = python {{ ephys_script }} --bids-root . --subject {subject} --session {session} {inputs}
{%- endif %}
# Defacing of the anatomical images heudiconv wrote, in place.
[datalad "containers.deface"]
	image = code/containers/images/skullduggery.sif
	cmdexec = apptainer run --no-home --cleanenv --bind /tmp:/root/.cache {img} {cmd}
	faire-sourcedata = .
	faire-input = sub-{subject}/ses-{session}/anat/*.nii.gz
	faire-output = sub-{subject}/ses-{session}/anat
	faire-after = heudiconv
	faire-cmd = skullduggery {inputs}
[datalad "containers.bids-validator"]
	image = code/repronim_containers/images/bids/bids-validator--3.0.1.sif
	cmdexec = apptainer exec -e {img} {cmd}
	faire-check = blocking
	faire-stage = collection
	faire-stage = release
	faire-cmd = bids-validator .
