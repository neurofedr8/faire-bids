# Confounds and other time series are large text
*_timeseries.tsv annex.largefiles=anything
*_physio.tsv annex.largefiles=anything
# Reports and figures render subject anatomy
*.html annex.largefiles=anything
*.svg annex.largefiles=anything
# FreeSurfer subjects directory (surfaces, volumes, labels, stats of the participant)
sourcedata/freesurfer/** annex.largefiles=anything
